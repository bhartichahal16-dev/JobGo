JWT_SECRET=your_jwt_secret_here

# MongoDB Atlas — connection string without database name at the end
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net

# Cloudinary — Dashboard → Settings → API Keys
CLOUDINARY_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_SECRET_KEY=your_api_secret

# Clerk — Dashboard → API Keys
CLERK_PUBLISHABLE_KEY=pk_test_xxxxx
CLERK_SECRET_KEY=sk_test_xxxxx
CLERK_WEBHOOK_SECRET=whsec_xxxxx

# Optional — used for local file URLs when Cloudinary upload fails
SERVER_URL=http://localhost:5000
PORT=5000

# Frontend URL — REQUIRED on Vercel (Clerk auth, ATS, resume download)
# Example: https://job-go-client.vercel.app
CLIENT_URL=https://your-client.vercel.app

# Optional: multiple origins comma-separated
# AUTHORIZED_ORIGINS=https://job-go-client.vercel.app,https://preview.vercel.app

# Local setup: API on :5000, Vite client on :5173 (see client/.env VITE_BACKEND_URL)
